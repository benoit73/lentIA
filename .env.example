# Copier en `.env` (docker compose le lit automatiquement) et renseigner
# tes propres valeurs. Voir README.md, section "Authentification (OAuth)".

# Client ID OAuth créé dans Google Cloud Console (type "Application web").
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Emails autorisés à se connecter au dashboard, séparés par des virgules.
# Laisser vide pour accepter n'importe quel compte Google.
ALLOWED_EMAILS=stroskanisation@gmail.com
